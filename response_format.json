{
  "type": "json_schema",
  "schema": {
    "type": "object",
    "properties": {
      "oldest_message_date": {
        "type": "string",
        "description": "Дата самого старого сообщения"
      },
      "dialogs_count": {
        "type": "integer",
        "description": "Количество проанализированных диалогов"
      },
      "ai_quality": {
        "type": "string",
        "description": "Уцени качество ответов проанализированных диалогов: Плохо, Удавлетворительно, Хорошо, Отлично)"
      },
      "issues": {
        "type": "array",
        "description": "Список проблемных ситуаций и срывов",
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "description": "Конкретное сообщение клиента"
            },
            "answer_json": {
              "type": "string",
              "description": "Оригинальный ответ консультанта одной строкой в формате JSON"
            },
            "problem": {
              "type": "string",
              "description": "Суть проблемы"
            }
          },
          "required": ["question", "answer_json", "problem"]
        }
      },
      "kb_recommendations": {
        "type": "array",
        "description": "Рекомендованные вопросы для добавления в базу знаний, оптимизированные для RAG/FAISS",
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "description": "Очищенное назывное предложение с синонимами (для вектора)"
            },
            "reason": {
              "type": "string",
              "description": "Почему это важно добавить"
            }
          },
          "required": ["question", "reason"]
        }
      }
    },
    "required": [
      "oldest_message_date",
      "dialogs_count",
      "ai_quality",
      "issues",
      "kb_recommendations"
    ]
  }
}
